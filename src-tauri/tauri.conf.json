{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Arc Desktop",
  "version": "0.1.0",
  "identifier": "com.arctab.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000/launcher",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Arc",
        "label": "main",
        "url": "launcher.html",
        "width": 720,
        "height": 540,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "skipTaskbar": true,
        "visible": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3OTdDNjdFMjlBREU4QUUKUldTdTZLMHBmc2FYTng5MjhBOWw5TEdaSER2Q2FVZWNGUGEyKzRYRk1qaHY0dGhCcWU0U040UjgK",
      "endpoints": [
        "https://github.com/spidey1102/Arc-Type-Search/releases/latest/download/latest.json"
      ]
    }
  }
}
